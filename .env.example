# Copie para .env e preencha. NUNCA commite o arquivo .env.

# Postgres (local, Supabase, Neon, RDS...). Usuário dono do schema (aplica migrations).
DATABASE_URL=postgres://retoma:retoma@localhost:5432/retoma_dev
# Banco usado pelos testes de integração (será limpo a cada execução)
TEST_DATABASE_URL=postgres://retoma:retoma@localhost:5432/retoma_test

# URL pública da aplicação (usada em links e cookies)
APP_URL=http://localhost:3000

# Chave de 32 bytes em base64 para criptografar segredos dos clientes (tokens da Meta).
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# WhatsApp Business Platform (Cloud API) — app da Meta
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
META_GRAPH_VERSION=v23.0

# Inteligência artificial (copiloto). Sem chave, os recursos de IA ficam desativados na interface.
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5

# Pagamentos (Asaas). Comece SEMPRE com sandbox (conta separada em sandbox.asaas.com).
ASAAS_API_KEY=
ASAAS_ENV=sandbox
# Token configurado no webhook do Asaas (32 a 255 caracteres, sem espaços, diferente da API key)
ASAAS_WEBHOOK_TOKEN=

# E-mail (convites e redefinição de senha) via SMTP de qualquer provedor (SES, Resend, Brevo...).
# Formato: smtps://usuario:senha@smtp.provedor.com:465
SMTP_URL=
EMAIL_FROM=Retoma <nao-responda@seudominio.com.br>

# Conexões por processo. Em serverless (Vercel) use a URL do POOLER do banco e um valor baixo (3).
DB_POOL_MAX=10
